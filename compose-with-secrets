#!/usr/bin/env bash
set -Eeuo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
op_vault="${OP_VAULT_BIN:-${HOME:?HOME is not set}/.codex/skills/1password-secrets/scripts/op-vault}"
template="$project_dir/ops/telegram-api.env.tpl"
compose=(docker compose --project-directory "$project_dir" -f "$project_dir/docker-compose.yml")

[[ "$#" -gt 0 ]] || { printf 'Usage: compose-with-secrets COMMAND [ARGUMENT...]\n' >&2; exit 2; }

# Buildx normally records client activity under ~/.docker/buildx. Keep this
# project-specific client cache alongside the other local runtime artifacts so
# ordinary builds do not need write access outside the repository.
if [[ "$1" == "build" ]]; then
  export BUILDX_CONFIG="$project_dir/volume/buildx"
  mkdir -p "$BUILDX_CONFIG"
fi

if [[ -n "${TELEGRAM_API_ID:-}" && -n "${TELEGRAM_API_HASH:-}" && -n "${OPENWEATHER_API_KEY:-}" ]]; then
  for variable_name in "${!OP_@}"; do
    unset "$variable_name"
  done
  exec "${compose[@]}" "$@"
fi

[[ -x "$op_vault" ]] || { printf 'compose-with-secrets: op-vault is unavailable\n' >&2; exit 1; }
[[ -r "$template" ]] || { printf 'compose-with-secrets: secret template is unavailable\n' >&2; exit 1; }
exec "$op_vault" run "$template" -- "${compose[@]}" "$@"
